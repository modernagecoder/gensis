# Copy this file to server/.env and fill in your own key.
# NEVER commit server/.env — it is listed in .gitignore.

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# true = only use Gemini (recommended); false = allow legacy Groq/NVIDIA failover
GEMINI_ONLY=true

# AI vs AI Arena models
ARENA_MODEL_A=gemini-3.8-flash
ARENA_MODEL_B=gemini-3.7-flash

# Server port (the Vite client proxies to it; set API_PORT for the client if you change it)
PORT=3001

# Optional legacy fallbacks (ignored while GEMINI_ONLY=true)
# GROQ_API_KEY=
# NVIDIA_API_KEY=
